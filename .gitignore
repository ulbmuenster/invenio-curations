# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
# As long as we install invenio-curations directly from a branch, we circumvent the github workflow for publishing on PyPi which also handles compiling translations. So we need to manually do this and version control the resulting *.mo files.
#*.mo

